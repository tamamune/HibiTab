{
  "manifest_version": 3,
  "name": "HibiTab - タブ整理＆日報",
  "short_name": "HibiTab",
  "version": "1.0.0",
  "description": "放置タブを自動でアーカイブして閉じ、その日に見たページを日報として Google ドライブに保存。お気に入り・よく見る・アーカイブのタブ管理も。",
  "permissions": ["tabs", "storage", "unlimitedStorage", "alarms", "idle", "identity", "favicon"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "app.html?popup=1",
    "default_title": "HibiTab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "app.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "ポップアップを開く"
    }
  }
}
